# FinSight environment configuration
# -----------------------------------
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# IMPORTANT: `.env` is git-ignored. NEVER commit real secrets, API keys,
# or credentials to version control.

# ---------------------------------------------------------------------------
# SEC EDGAR User-Agent  (REQUIRED for live SEC requests)
# ---------------------------------------------------------------------------
# The SEC requires every automated client to send a User-Agent that
# identifies who is making the request, including a contact email.
# See: https://www.sec.gov/os/accessing-edgar-data
# Use YOUR OWN name and an email that reaches you. FinSight has no fallback
# identity: without this — or with the placeholder below left unedited, or with
# only an undeliverable address (example.com/.net/.org, .example/.invalid/
# .localhost/.test, no-reply) — a live SEC request fails with an error naming
# this variable. Demo mode (FINSIGHT_DEMO=1) does not need it.
# SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"

# ---------------------------------------------------------------------------
# OpenAI API key  (OPTIONAL — enables LLM-based KPI extraction)
# ---------------------------------------------------------------------------
# When set, KPIExtractor.extract_from_text() uses an LLM (GPT-4o-mini by
# default) to extract financial metrics from filing text. When unset, FinSight
# automatically falls back to deterministic regex/XBRL extraction, so the
# library remains fully functional without a key.
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional overrides for the LLM client:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# REST API bind settings  (OPTIONAL)
# ---------------------------------------------------------------------------
# Override the host/port the `finsight` console script binds to
# (default 127.0.0.1:8001 — loopback only). FINSIGHT_RELOAD=1 enables
# auto-reload for development. The Docker image binds 0.0.0.0 on its own.
# FINSIGHT_HOST=127.0.0.1
# FINSIGHT_PORT=8001
# FINSIGHT_RELOAD=1

# ---------------------------------------------------------------------------
# Demo / offline mode  (OPTIONAL)
# ---------------------------------------------------------------------------
# When FINSIGHT_DEMO=1, the API serves bundled data for AAPL, MSFT, NVDA,
# GOOGL and TSLA (real SEC companyfacts snapshots retrieved 2026-11-04, and the
# 2026-10-30 closing prices) through the SAME code as the live path — no SEC EDGAR network
# call and no API keys required. Any other ticker is refused (404), never looked
# up live. Ideal for a zero-config clone-and-run demo and for CI. Leave unset (default) to use the live SEC EDGAR path; the demo
# fixtures still act as an automatic fallback when SEC is unreachable.
# FINSIGHT_DEMO=1

# ---------------------------------------------------------------------------
# Live earnings-call transcripts  (OPTIONAL — off by default)
# ---------------------------------------------------------------------------
# In live mode, =1 scrapes transcripts from fool.com, a third-party site. FinSight
# has not reviewed whether its terms allow this; that is yours to check first. Off,
# no request is made and /sentiment and /report say "not available".
# FINSIGHT_LIVE_TRANSCRIPTS=1

# ---------------------------------------------------------------------------
# Frontend → backend wiring  (used by the Next.js app, NOT the Python API)
# ---------------------------------------------------------------------------
# The frontend reads NEXT_PUBLIC_API_URL to find the backend. It is baked in
# at BUILD time. Under `next dev` it defaults to http://localhost:8001; a
# production build without it has no engine and replays the labelled recording
# of one (no request). So does a configured backend that does not answer, so the
# build/static deploy never breaks.
# NEXT_PUBLIC_API_URL=http://localhost:8001
